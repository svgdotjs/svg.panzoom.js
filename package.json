{
  "name": "@svgdotjs/svg.panzoom.js",
  "version": "2.1.2",
  "description": "A plugin for svg.js that enables panzoom for viewport elements",
  "type": "module",
  "packageManager": "pnpm@11.26.0",
  "main": "dist/svg.panzoom.js",
  "module": "dist/svg.panzoom.mjs",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/svg.panzoom.d.mts",
        "default": "./dist/svg.panzoom.mjs"
      },
      "import": {
        "types": "./dist/svg.panzoom.d.mts",
        "default": "./dist/svg.panzoom.mjs"
      },
      "require": {
        "types": "./dist/svg.panzoom.d.ts",
        "default": "./dist/svg.panzoom.js"
      }
    },
    "./package.json": "./package.json"
  },
  "unpkg": "dist/svg.panzoom.js",
  "jsdelivr": "dist/svg.panzoom.js",
  "files": [
    "/dist",
    "!/dist/*.zip"
  ],
  "keywords": [
    "svg.js",
    "panzoom"
  ],
  "bugs": "https://github.com/svgdotjs/svg.panzoom.js/issues",
  "license": "MIT",
  "typings": "./dist/svg.panzoom.d.ts",
  "author": "Ulrich-Matthias Schäfer",
  "homepage": "https://github.com/svgdotjs/svg.panzoom.js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/svgdotjs/svg.panzoom.js.git"
  },
  "scripts": {
    "build": "tsc && vite build",
    "fix": "oxfmt --write . && oxlint -D correctness --fix .",
    "lint": "oxfmt --check . && oxlint -D correctness .",
    "prepublishOnly": "rm -rf ./dist && pnpm lint && pnpm build && pnpm zip",
    "zip": "zip -j dist/svg.panzoom.js.zip -- license readme.md dist/svg.panzoom.js",
    "test": "node --test test/*.test.js"
  },
  "peerDependencies": {
    "@svgdotjs/svg.js": "^3.1.0"
  },
  "devDependencies": {
    "@svgdotjs/svg.js": "^3.2.8",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "svgdom": "^0.1.28",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
